{
  "name": "nova-pc",
  "version": "0.4.0",
  "description": "Nova PC - escritorio virtual de Windows",
  "main": "main.js",
  "author": "Nova PC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.novapc.desktop",
    "productName": "Nova PC",
    "directories": { "output": "dist" },
    "files": ["index.html", "style.css", "script.js", "main.js", "preload.js", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
